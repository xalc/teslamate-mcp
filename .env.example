TESLAMATE_TIMEZONE=UTC
TESLAMATE_BIND_ADDRESS=127.0.0.1
TESLAMATE_MCP_PORT=8766
TESLAMATE_COST_PORT=8767
TESLAMATE_DOCKER_NETWORK=teslamate_default

# hidden | coarse | precise. Coarse is the safe default.
TESLAMATE_LOCATION_PRIVACY=coarse
TESLAMATE_LOCATION_COORD_DECIMALS=2
# Use the in-container path after copying the example file to the ignored file.
TESLAMATE_LOCATION_ALIASES_FILE=/config/location-aliases.json

# Add only hostnames that clients actually use.
TESLAMATE_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
TESLAMATE_COST_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
